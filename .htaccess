<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent directory listing
    Options -Indexes
    RewriteRule ^(storage/(private|tmp|sessions)|bin|scripts|database|config|app|vendor)(/|$) - [F,L]

    # Route backend API & Auth endpoints to PHP Front Controller
    RewriteRule ^(csrf-token|login|logout|change-password|api)(/.*)?$ public/index.php [L,QSA]

    # Files uploaded by the CMS live under the PHP public directory.
    RewriteCond %{DOCUMENT_ROOT}/rayongcoop-react/public/storage/$1 -f
    RewriteRule ^storage/(.*)$ public/storage/$1 [L]

    # Serve public static files (images, uploads, and documents) before SPA routing.
    RewriteCond %{DOCUMENT_ROOT}/rayongcoop-react/public/$1 -f
    RewriteRule ^(.*)$ public/$1 [L]

    # Serve built React assets from the PHP document root
    RewriteCond %{DOCUMENT_ROOT}/rayongcoop-react/public/app/$1 -f
    RewriteRule ^(.*)$ public/app/$1 [L]

    # If requested file or directory exists directly, serve it
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route all SPA routes to the React entrypoint
    RewriteRule ^ public/app/index.html [L]
</IfModule>
