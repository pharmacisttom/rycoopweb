APP_NAME="RayongCoop Digital Portal"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://rayongcoop.tomvisolution.tech
APP_TIMEZONE=Asia/Bangkok
APP_KEY=

# Initial administrator bootstrap. Set a unique value of at least 16 characters
# in your untracked .env before running `php bin/console db:seed`.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@rayongcoop.com
INITIAL_ADMIN_PASSWORD=

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rayongcoop_db
DB_USERNAME=rayongcoop_user
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Session & Security
SESSION_LIFETIME=7200
SESSION_SECURE=true
SESSION_HTTPONLY=true
SESSION_SAMESITE=Lax
SESSION_SAVE_PATH=/var/lib/php/sessions

# Member modules remain installed but are disabled until formal approval.
FEATURE_MEMBER_PORTAL=false
FEATURE_MEMBER_LOGIN=false
FEATURE_MEMBER_ESERVICE=false
FEATURE_MEMBER_FINANCIAL_DATA=false
VITE_FEATURE_MEMBER_PORTAL=false

# 2FA Settings
TWO_FACTOR_ISSUER="RayongCoop"
TWO_FACTOR_WINDOW=1

# Rate Limiting
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_DECAY=900

# Mail Configuration (Optional / Phase 6)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@rayongcoop.com"
MAIL_FROM_NAME="Rayong Public Health Cooperative"

# LED Open Data Configuration (Legal Execution Department)
LED_API_URL=https://opendata.led.go.th/api/3/action/datastore_search
LED_RESOURCE_ID=e916cc37-78b6-4dbf-bc0f-4bee020cb830
LED_TIMEOUT=15
LED_BATCH_SIZE=50
LED_RETRY_LIMIT=3
LED_REQUEST_DELAY_MS=500
LED_TIMEZONE=Asia/Bangkok
