#!/usr/bin/env php
<?php

declare(strict_types=1);

require_once __DIR__ . '/../vendor/autoload.php';

use App\Core\Database;
use Database\Seeders\DatabaseSeeder;

$command = $argv[1] ?? 'help';

echo "RayongCoop Digital Portal CLI Tool v1.0\n";
echo "----------------------------------------\n";

switch ($command) {
    case 'db:create':
        $config = config('database.connections.mysql');
        $dsn = sprintf('mysql:host=%s;port=%d', $config['host'], $config['port']);
        try {
            $pdo = new PDO($dsn, $config['username'], $config['password'], [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION]);
            $dbName = $config['database'];
            $pdo->exec("CREATE DATABASE IF NOT EXISTS `{$dbName}` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;");
            echo "✓ Database `{$dbName}` created or already exists.\n";
        } catch (PDOException $e) {
            echo "✗ Error creating database: " . $e->getMessage() . "\n";
            exit(1);
        }
        break;

    case 'db:migrate':
        try {
            // First ensure DB exists
            $config = config('database.connections.mysql');
            $dsn = sprintf('mysql:host=%s;port=%d', $config['host'], $config['port']);
            $pdoInit = new PDO($dsn, $config['username'], $config['password'], [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION]);
            $pdoInit->exec("CREATE DATABASE IF NOT EXISTS `{$config['database']}` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;");

            $pdo = Database::connect();

            // Create migration tracking table if it doesn't exist
            $pdo->exec("CREATE TABLE IF NOT EXISTS `migrations` (
                `id` INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
                `migration` VARCHAR(255) NOT NULL UNIQUE,
                `applied_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;");

            // Get already-applied migrations
            $applied = [];
            $stmt = $pdo->query("SELECT migration FROM migrations ORDER BY id ASC");
            foreach ($stmt->fetchAll(PDO::FETCH_COLUMN) as $m) {
                $applied[$m] = true;
            }

            $migrationFiles = glob(__DIR__ . '/../database/migrations/*.sql');
            sort($migrationFiles);

            $newCount = 0;
            foreach ($migrationFiles as $file) {
                $basename = basename($file);
                if (isset($applied[$basename])) {
                    echo "⏭  Already applied: {$basename}\n";
                    continue;
                }
                echo "Running migration: {$basename}...\n";
                $sql = file_get_contents($file);
                $pdo->exec($sql);
                $pdo->prepare("INSERT INTO migrations (migration) VALUES (?)")->execute([$basename]);
                echo "✓ Applied {$basename}\n";
                $newCount++;
            }
            echo $newCount > 0
                ? "{$newCount} new migration(s) applied successfully!\n"
                : "Nothing to migrate — all migrations are up to date.\n";
        } catch (Exception $e) {
            echo "✗ Migration failed: " . $e->getMessage() . "\n";
            exit(1);
        }
        break;

    case 'db:seed':
        try {
            DatabaseSeeder::run();
        } catch (Exception $e) {
            echo "✗ Seeding failed: " . $e->getMessage() . "\n";
            exit(1);
        }
        break;

    case 'cron:run':
        echo "Running scheduled jobs...\n";
        $pdo = Database::connect();
        
        // 1. Expire outdated announcements
        $stmt = $pdo->prepare("UPDATE announcements SET is_active = 0 WHERE is_active = 1 AND end_at IS NOT NULL AND end_at < NOW()");
        $stmt->execute();
        echo "✓ Checked announcements.\n";

        // 2. Expire popups
        $stmt = $pdo->prepare("UPDATE popups SET status = 'inactive' WHERE status = 'active' AND end_at IS NOT NULL AND end_at < NOW()");
        $stmt->execute();
        echo "✓ Checked popups.\n";

        // 3. Clean old login logs (older than 90 days)
        $stmt = $pdo->prepare("DELETE FROM login_logs WHERE created_at < DATE_SUB(NOW(), INTERVAL 90 DAY)");
        $stmt->execute();
        echo "✓ Cleaned old login logs.\n";

        // 4. RYCOOP LED Member Check (Scheduled at 08:00 Asia/Bangkok)
        try {
            $tz = new DateTimeZone('Asia/Bangkok');
            $now = new DateTime('now', $tz);
            $currentTime = $now->format('H:i');
            $currentDate = $now->format('Y-m-d');

            $ledService = new \App\Services\LedService();
            $dbSettings = $ledService->getDbSettings();

            $autoEnabled = ($dbSettings['led_auto_check_enabled'] ?? '0') === '1' || ($dbSettings['led_auto_check_enabled'] ?? '') === 'true';
            $scheduledTime = $dbSettings['led_auto_check_time'] ?? '08:00';

            if ($autoEnabled) {
                $forceRun = in_array('--force-led', $argv, true);
                if ($currentTime === $scheduledTime || $forceRun) {
                    $existingToday = Database::first(
                        "SELECT id FROM led_check_runs WHERE run_type = 'SCHEDULED' AND DATE(created_at) = ? LIMIT 1",
                        [$currentDate]
                    );

                    if ($existingToday && !$forceRun) {
                        echo "ℹ LED Scheduled Check: Already executed for today ({$currentDate}), skipping duplicate run.\n";
                    } else {
                        echo "Running LED Scheduled Member Check (Time: {$currentTime})...\n";
                        $batchService = new \App\Services\LedBatchService($ledService);
                        $created = $batchService->createBatchRun([], 'SCHEDULED', null);

                        if ($created['success']) {
                            $runId = (int) $created['run_id'];
                            $batchSize = $ledService->getConfiguredBatchSize();
                            $result = $batchService->executeRun($runId, [], $batchSize);
                            echo "✓ LED Scheduled Check completed for Run #{$runId}: Status {$result['status']}, Checked: {$result['checked_members']}/{$result['total_members']}\n";
                        } else {
                            echo "✗ LED Scheduled Check could not create run: " . ($created['message'] ?? 'Unknown error') . "\n";
                        }
                    }
                } else {
                    echo "ℹ LED Scheduled Check: Current time ({$currentTime}) does not match scheduled time ({$scheduledTime}).\n";
                }
            } else {
                echo "ℹ LED Scheduled Check is disabled in settings.\n";
            }
        } catch (\Throwable $e) {
            echo "✗ LED Scheduled Check error: " . $e->getMessage() . "\n";
        }

        echo "All scheduled cron tasks completed.\n";
        break;

    case 'led:run':
        $runId = (int) ($argv[2] ?? 0);
        if ($runId <= 0) {
            echo "Usage: php bin/console led:run <runId>\n";
            exit(1);
        }
        echo "Processing LED Member Check Run #{$runId}...\n";
        try {
            $batchService = new \App\Services\LedBatchService();
            $result = $batchService->executeRun($runId);
            if ($result['success']) {
                echo "✓ Successfully processed Run #{$runId}: Status {$result['status']} (Checked: {$result['checked_members']}/{$result['total_members']})\n";
            } else {
                echo "✗ Failed to process Run #{$runId}: " . ($result['message'] ?? 'Unknown error') . "\n";
                exit(1);
            }
        } catch (\Throwable $e) {
            echo "✗ Exception while running LED Check: " . $e->getMessage() . "\n";
            exit(1);
        }
        break;

    case 'backup:run':
        echo "Creating database backup...\n";
        $backupDir = __DIR__ . '/../storage/backups';
        if (!is_dir($backupDir)) {
            @mkdir($backupDir, 0775, true);
        }
        $filename = 'backup_' . date('Y_m_d_His') . '_' . bin2hex(random_bytes(4)) . '.sql';
        $target = "{$backupDir}/{$filename}";

        $config = config('database.connections.mysql');
        // Simple SQL dump
        $pdo = Database::connect();
        $tables = $pdo->query("SHOW TABLES")->fetchAll(PDO::FETCH_COLUMN);
        
        $dump = "-- RayongCoop Database Backup\n-- Generated: " . date('Y-m-d H:i:s') . "\n\nSET FOREIGN_KEY_CHECKS=0;\n";
        foreach ($tables as $table) {
            $createTable = $pdo->query("SHOW CREATE TABLE `{$table}`")->fetch(PDO::FETCH_ASSOC);
            $dump .= "\nDROP TABLE IF EXISTS `{$table}`;\n" . $createTable['Create Table'] . ";\n\n";
            $rows = $pdo->query("SELECT * FROM `{$table}`")->fetchAll(PDO::FETCH_ASSOC);
            foreach ($rows as $row) {
                $fields = array_map(function($val) use ($pdo) {
                    return $val === null ? 'NULL' : $pdo->quote((string)$val);
                }, array_values($row));
                $dump .= "INSERT INTO `{$table}` VALUES (" . implode(', ', $fields) . ");\n";
            }
        }
        $dump .= "\nSET FOREIGN_KEY_CHECKS=1;\n";
        $previousMask = umask(0077);
        $written = file_put_contents($target, $dump, LOCK_EX);
        umask($previousMask);
        if ($written === false || $written !== strlen($dump)) {
            fwrite(STDERR, "Backup failed: incomplete dump write.\n"); exit(1);
        }
        chmod($target, 0600);
        $digest = hash_file('sha256', $target);
        if (!$digest || file_put_contents($target . '.sha256', $digest . '  ' . basename($target) . PHP_EOL, LOCK_EX) === false) {
            fwrite(STDERR, "Backup failed: checksum could not be written.\n"); exit(1);
        }
        chmod($target . '.sha256', 0600);
        echo "✓ Backup created: {$filename} (" . number_format(filesize($target) / 1024, 2) . " KB)\n";
        break;

    case 'auth:bootstrap-superadmin':
        $targetEmail = strtolower(trim((string) ($argv[2] ?? config('google.primary_superadmin_email', 'pharmacisttom@gmail.com'))));
        echo "Primary Super Admin Bootstrap Procedure\n";
        echo "----------------------------------------\n";
        echo "Designated Email: {$targetEmail}\n";

        $pdo = Database::connect();
        // 1. Verify super_admin role exists
        $superAdminRoleId = (int) Database::value("SELECT id FROM roles WHERE slug = 'super_admin' LIMIT 1");
        if ($superAdminRoleId <= 0) {
            echo "✗ Error: super_admin role not found in database.\n";
            exit(1);
        }

        // 2. Find or ensure primary local super_admin account exists
        $superAdmin = Database::first(
            "SELECT u.id, u.username, u.email, u.status 
             FROM users u 
             JOIN user_roles ur ON u.id = ur.user_id 
             WHERE ur.role_id = ? AND u.deleted_at IS NULL 
             ORDER BY u.id ASC LIMIT 1",
            [$superAdminRoleId]
        );

        if (!$superAdmin) {
            echo "Creating initial local Super Admin account...\n";
            $uuid = bin2hex(random_bytes(16));
            $randomPassword = password_hash(bin2hex(random_bytes(32)), PASSWORD_ARGON2ID);
            $userId = (int) Database::insert(
                "INSERT INTO users (uuid, name, username, email, password, status, created_at, updated_at) 
                 VALUES (?, 'ผู้ดูแลระบบสูงสุด', 'superadmin', ?, ?, 'active', NOW(), NOW())",
                [$uuid, $targetEmail, $randomPassword]
            );
            Database::execute("INSERT INTO user_roles (user_id, role_id) VALUES (?, ?)", [$userId, $superAdminRoleId]);
            echo "✓ Created local Super Admin account (ID: {$userId})\n";
        } else {
            $userId = (int) $superAdmin['id'];
            echo "✓ Found existing local Super Admin account (ID: {$userId}, User: {$superAdmin['username']})\n";
            // Update email to designated approved identity
            Database::execute("UPDATE users SET email = ?, updated_at = NOW() WHERE id = ?", [$targetEmail, $userId]);
        }

        // 3. Check if already linked
        $linked = Database::first("SELECT google_sub, google_email, linked_at FROM user_google_identities WHERE user_id = ? LIMIT 1", [$userId]);
        if ($linked) {
            echo "ℹ Notice: Account is already linked to Google sub: {$linked['google_sub']} ({$linked['google_email']}) on {$linked['linked_at']}\n";
            echo "To re-link, run: php bin/console auth:unlink-user {$userId}\n";
            break;
        }

        // 4. Enable authorized one-time bootstrap linking flag
        Database::execute(
            "INSERT INTO site_settings (`key`, `value`, `group`, updated_at) 
             VALUES ('superadmin_bootstrap_enabled', '1', 'system', NOW()) 
             ON DUPLICATE KEY UPDATE `value` = '1', `updated_at` = NOW()"
        );

        // 5. Also create a pending staff invitation record for pharmacisttom@gmail.com with super_admin role
        // so both invitation matching and bootstrap matching work seamlessly and auditably
        $token = bin2hex(random_bytes(32));
        $tokenHash = hash('sha256', $token);
        Database::execute(
            "INSERT INTO staff_invitations (email, name, department, intended_role_id, invited_by, token_hash, expires_at, status, created_at, updated_at) 
             VALUES (?, 'Super Admin (Bootstrap)', 'บริหารจัดการระบบ', ?, ?, ?, DATE_ADD(NOW(), INTERVAL 7 DAY), 'pending', NOW(), NOW())
             ON DUPLICATE KEY UPDATE status = 'pending', token_hash = VALUES(token_hash), expires_at = VALUES(expires_at), updated_at = NOW()",
            [$targetEmail, $superAdminRoleId, $userId, $tokenHash]
        );

        echo "✓ One-time bootstrap authorized successfully!\n";
        echo "Instructions for {$targetEmail}:\n";
        echo "1. Go to: " . url('admin/login') . "\n";
        echo "2. Click 'เข้าสู่ระบบด้วยบัญชี Google'\n";
        echo "3. Authenticate with {$targetEmail}\n";
        echo "4. The application will verify the Google OpenID Connect ID Token and bind your immutable Google sub claim to the local Super Admin account.\n";
        echo "5. You will be prompted to complete mandatory 2FA enrollment.\n";
        break;

    case 'auth:unlink-user':
        $userId = (int) ($argv[2] ?? 0);
        if ($userId <= 0) {
            echo "Usage: php bin/console auth:unlink-user <userId>\n";
            exit(1);
        }
        $googleAuth = new \App\Services\GoogleAuthService();
        $googleAuth->unlinkUser($userId);
        \App\Core\Auth::revokeAllSessions($userId);
        echo "✓ Unlinked Google identity and revoked active sessions for User ID {$userId}.\n";
        break;

    case 'help':
    default:
        echo "Usage: php bin/console <command>\n\n";
        echo "Available commands:\n";
        echo "  db:create                  Create the MySQL database if it doesn't exist\n";
        echo "  db:migrate                 Run all database SQL migrations\n";
        echo "  db:seed                    Run database seeders with initial financial & system data\n";
        echo "  auth:bootstrap-superadmin  Authorize one-time Google OIDC bootstrap for primary Super Admin\n";
        echo "  auth:unlink-user <id>      Unlink Google identity for a specific user ID\n";
        echo "  cron:run                   Run scheduled system tasks (content schedules, cleanups)\n";
        echo "  backup:run                 Create a full database SQL backup archive\n";
        break;
}
